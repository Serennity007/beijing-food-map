# 京城黔味地图 API — 环境变量清单（只允许占位值，不放任何真实密钥）
# 注意：后端进程只读真实环境变量，没有内置 .env 加载。
# 本地用 `SESSION_SECRET=xxx npm run dev:api` 或先 export；线上由托管平台注入。

# HTTP 监听端口（默认 8787，与 Vite dev proxy 对齐）
PORT=
# production 会拒绝装载测试种子并直接以退出码 1 失败（见 docs/runbooks/deploy-api.md）
NODE_ENV=
# 监听地址；容器里通常填 0.0.0.0（默认 development 下为 127.0.0.1）
HOST=
# SQLite 文件路径（默认 ./data/demo.sqlite；目录会自动创建）
SQLITE_PATH=
# 逗号分隔的跨域/CSRF 允许来源，例如 http://localhost:5173,https://demo.example.com
ALLOWED_ORIGINS=
# 每个 IP+账号每分钟允许的登录次数（默认 10）
LOGIN_RATE_LIMIT_PER_MIN=
# 会话 Cookie 签名密钥：留空则进程启动时随机生成，重启后需重新登录。
# 填固定值需至少 32 个字符；production 必填。轮换密钥会让旧 Cookie 全部失效。
SESSION_SECRET=
# 会话有效期秒数（60—2592000，默认 2592000 = 30 天）
SESSION_TTL_SECONDS=
# 是否给会话 Cookie 附加 Secure（true|false）；production 强制 true，填 false 会启动失败
COOKIE_SECURE=
