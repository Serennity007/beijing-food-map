# 只包含空值或占位符。真实凭据通过部署平台的环境变量/密钥管理注入，
# 不要提交到仓库，也不要粘贴到公开文档、issue 或截图里。
#
# 分两类：【已接入】是当前代码真正读取的变量；【上线前接入】是说明书要求、
# demo 用替代实现顶掉的集成点，写在这里是为了迁移时不再重新发明。

# ------------------------------------------------------------ 已接入：运行环境
# development | test | production（production 会拒绝装载测试种子与演示登录）
NODE_ENV=development

# ------------------------------------------------------------ 已接入：演示后端
PORT=8787
HOST=127.0.0.1
# demo 用本地 SQLite 文档表代替 Postgres；相对路径按进程工作目录解析
SQLITE_PATH=./data/demo.sqlite
# 逗号分隔的 Origin 白名单，不允许 *（会话是 Cookie，跨站写必须显式放行）
ALLOWED_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_PER_MIN=10
# 会话签名密钥：留空则每次启动随机生成，重启后所有人要重新登录。
# 填固定值（至少 32 字符随机串）后重启仍承认旧 Cookie；轮换密钥即作废旧会话。
SESSION_SECRET=
# 会话有效期秒数，60—2592000，默认 30 天。同时用于 Cookie 的 Max-Age。
SESSION_TTL_SECONDS=2592000
# 是否给会话 Cookie 附加 Secure。production 强制 true；http 本地调试可留默认。
COOKIE_SECURE=

# ------------------------------------------------------------ 已接入：前端构建期
# GitHub Pages 项目页要写成 /<仓库名>/
VITE_BASE=/
# 留空 = 浏览器内静态演示（数据在 localStorage）；填绝对地址 = 走后端 API
VITE_API_BASE=
# 只给 vite dev server 用：把 /api 代理到本地后端
VITE_API_PROXY=http://127.0.0.1:8787
# 开源底图样式与兜底栅格（留空用内置的 OpenFreeMap / CARTO 公共瓦片）
VITE_MAP_STYLE=
VITE_MAP_FALLBACK_STYLE=
# 高德 JS API 2.0：Key 与安全密钥可在控制台限定域名后公开；Web 服务 Key 只留服务端
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=

# ------------------------------------------------------------ 上线前接入：真实凭据
# 生产数据库连接串（替换 SQLITE_PATH 的文档表方案）
DATABASE_URL=
# 对象存储：demo 用内联合成图片 + /media/:id 鉴权直出，不上报任何真实照片
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# 短信验证码：demo 用邀请账号 + 固定码（只存在于非 production）
SMS_PROVIDER=
SMS_APP_KEY=
SMS_APP_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
